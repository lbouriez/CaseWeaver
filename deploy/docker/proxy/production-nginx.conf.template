# The official nginx unprivileged image expands only CASEWEAVER_EDGE_* variables.
# Native nginx variables such as $host and $remote_addr remain intact.

server {
    listen 8080;
    server_name _;
    server_tokens off;
    return 308 https://$host:${CASEWEAVER_EDGE_PUBLIC_HTTPS_PORT}$request_uri;
}

server {
    listen 8443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate /run/caseweaver-tls/certificate.pem;
    ssl_certificate_key /run/caseweaver-tls/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:CaseWeaverTLS:10m;

    client_max_body_size 10m;
    client_body_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;

    resolver 127.0.0.11 ipv6=off valid=10s;
    set $api_upstream ${CASEWEAVER_EDGE_API_UPSTREAM};
    set $webhook_upstream ${CASEWEAVER_EDGE_WEBHOOK_UPSTREAM};
    set $admin_upstream admin:8080;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location /v1/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /health/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /webhooks/ {
        proxy_pass http://$webhook_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://$admin_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}
