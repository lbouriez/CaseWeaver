# Copy outside the repository as an absolute-path Portainer stack environment file.
# Values here are public deployment configuration only. Keep passwords, tokens, keys,
# database URLs, and TLS material in the individual absolute secret files below.

CASEWEAVER_RELEASE_VERSION=
# Every image must be an immutable linux/amd64 reference: registry/name@sha256:<64 hex>.
CASEWEAVER_POSTGRES_IMAGE=
CASEWEAVER_MIGRATION_IMAGE=
CASEWEAVER_STANDALONE_IMAGE=
CASEWEAVER_ATTACHMENT_PROCESSOR_IMAGE=
CASEWEAVER_EDGE_IMAGE=
CASEWEAVER_S3_OPERATIONS_IMAGE=

# The exact Cloudflare Pages Admin origin and API edge configuration.
ADMIN_ALLOWED_ORIGINS=https://your-admin.pages.dev
ADMIN_SESSION_COOKIE_SAME_SITE=none
API_WORKSPACE_ID=
API_PRINCIPAL_ID=
TRUSTED_PROXY_CIDRS=172.31.0.0/24
CASEWEAVER_APPLICATION_SUBNET=172.31.0.0/24
CASEWEAVER_EGRESS_SUBNET=172.32.0.0/24
CASEWEAVER_EDGE_HTTP_BINDING=80
CASEWEAVER_EDGE_HTTPS_BINDING=443
CASEWEAVER_EDGE_PUBLIC_HTTPS_PORT=443

POSTGRES_DB=caseweaver
POSTGRES_USER=caseweaver_migrator
CASEWEAVER_RUNTIME_DATABASE_ROLE=caseweaver_runtime
ADMIN_DISABLE_LOGIN_AUTHENTICATION=true
ADMIN_ENABLE_PASSWORD_AUTHENTICATION=false

# OIDC callback is the public API edge, not the Cloudflare Pages UI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CALLBACK_URL=https://api.example.com/v1/auth/callback
OIDC_EPHEMERAL_KEY_ID=
ADMIN_BOOTSTRAP_OIDC_SUBJECT=
ADMIN_BOOTSTRAP_DISPLAY_NAME=

# CaseWeaver production storage is an external S3-compatible service.
OBJECT_STORAGE_BACKEND_ID=
OBJECT_STORAGE_KEY_PREFIX=caseweaver
OBJECT_STORAGE_S3_ENDPOINT=https://object-storage.example.com
OBJECT_STORAGE_S3_REGION=
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_FORCE_PATH_STYLE=false
OBJECT_STORAGE_S3_ENCRYPTION=AES256
OBJECT_STORAGE_S3_KMS_KEY_ID=
CASEWEAVER_APPLICATION_SECRETS_DIRECTORY=/absolute/operator-owned/caseweaver/application-secrets

# Each value must be an absolute path on the Docker Standalone node. Disabled
# optional features still need an intentionally empty, access-restricted file.
CASEWEAVER_POSTGRES_PASSWORD_FILE=/absolute/operator-owned/caseweaver/secrets/postgres-password
CASEWEAVER_RUNTIME_DATABASE_PASSWORD_FILE=/absolute/operator-owned/caseweaver/secrets/runtime-database-password
CASEWEAVER_MIGRATION_DATABASE_URL_FILE=/absolute/operator-owned/caseweaver/secrets/migration-database-url
CASEWEAVER_RUNTIME_DATABASE_URL_FILE=/absolute/operator-owned/caseweaver/secrets/runtime-database-url
CASEWEAVER_OIDC_CLIENT_SECRET_FILE=/absolute/operator-owned/caseweaver/secrets/oidc-client-secret
CASEWEAVER_OIDC_EPHEMERAL_ENCRYPTION_KEY_FILE=/absolute/operator-owned/caseweaver/secrets/oidc-ephemeral-encryption-key
CASEWEAVER_ADMIN_LOGIN_FILE=/absolute/operator-owned/caseweaver/secrets/admin-login
CASEWEAVER_ADMIN_PASSWORD_FILE=/absolute/operator-owned/caseweaver/secrets/admin-password
CASEWEAVER_OBJECT_STORAGE_KEY_DERIVATION_SECRET_FILE=/absolute/operator-owned/caseweaver/secrets/object-storage-key-derivation-secret
CASEWEAVER_OBJECT_STORAGE_S3_ACCESS_KEY_ID_FILE=/absolute/operator-owned/caseweaver/secrets/object-storage-s3-access-key-id
CASEWEAVER_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY_FILE=/absolute/operator-owned/caseweaver/secrets/object-storage-s3-secret-access-key
CASEWEAVER_TRUSTED_CA_FILE=/absolute/operator-owned/caseweaver/secrets/trusted-ca-certificate
CASEWEAVER_TLS_CERTIFICATE_FILE=/absolute/operator-owned/caseweaver/secrets/tls-certificate
CASEWEAVER_TLS_PRIVATE_KEY_FILE=/absolute/operator-owned/caseweaver/secrets/tls-private-key
