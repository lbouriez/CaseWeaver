# Copy this file outside the repository as .env.production and set every value.
# Values are public deployment configuration only. Secret values live in restrictive
# files referenced below; this file must never contain a password, token, or URL with
# embedded credentials.

CASEWEAVER_RELEASE_VERSION=
CASEWEAVER_POSTGRES_IMAGE=
CASEWEAVER_MIGRATION_IMAGE=
CASEWEAVER_API_IMAGE=
CASEWEAVER_ADMIN_IMAGE=
CASEWEAVER_WORKER_IMAGE=
CASEWEAVER_SCHEDULER_IMAGE=
CASEWEAVER_WEBHOOK_IMAGE=
CASEWEAVER_STANDALONE_IMAGE=
CASEWEAVER_ATTACHMENT_PROCESSOR_IMAGE=
CASEWEAVER_EDGE_IMAGE=
# A digest-pinned generic S3 client used only by the explicit backup/restore helper.
CASEWEAVER_S3_OPERATIONS_IMAGE=

# One public TLS Admin origin, for example https://caseweaver.example.com.
ADMIN_ALLOWED_ORIGINS=
API_WORKSPACE_ID=
API_PRINCIPAL_ID=
TRUSTED_PROXY_CIDRS=172.28.0.0/24
CASEWEAVER_APPLICATION_SUBNET=172.28.0.0/24
CASEWEAVER_EGRESS_SUBNET=172.29.0.0/24
CASEWEAVER_EDGE_HTTP_BINDING=80
CASEWEAVER_EDGE_HTTPS_BINDING=443
CASEWEAVER_EDGE_PUBLIC_HTTPS_PORT=443
# Set these exactly for the mode selected by the helper:
# standalone -> standalone:3000 / standalone:8081
# distributed -> api:3000 / webhook:8081
CASEWEAVER_EDGE_API_UPSTREAM=
CASEWEAVER_EDGE_WEBHOOK_UPSTREAM=

POSTGRES_DB=caseweaver
POSTGRES_USER=caseweaver_migrator
CASEWEAVER_RUNTIME_DATABASE_ROLE=caseweaver_runtime
ADMIN_DISABLE_LOGIN_AUTHENTICATION=true
ADMIN_ENABLE_PASSWORD_AUTHENTICATION=false

# Feature configuration is public. Their secret values are supplied by files below or
# by individual safe-named files in CASEWEAVER_APPLICATION_SECRETS_DIRECTORY.
# Production supports encrypted S3-compatible object storage only.
OBJECT_STORAGE_KIND=s3
OBJECT_STORAGE_BACKEND_ID=
OBJECT_STORAGE_KEY_PREFIX=caseweaver
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_REGION=
OBJECT_STORAGE_S3_BUCKET=
# A different, versioned backup bucket in the same trusted S3-compatible account.
OBJECT_STORAGE_S3_BACKUP_BUCKET=
OBJECT_STORAGE_S3_BACKUP_PREFIX=caseweaver-backups
OBJECT_STORAGE_S3_FORCE_PATH_STYLE=false
OBJECT_STORAGE_S3_ENCRYPTION=AES256
OBJECT_STORAGE_S3_KMS_KEY_ID=
CASEWEAVER_APPLICATION_SECRETS_DIRECTORY=

# Each path names an operator-owned file. Optional/disabled features still use an empty
# file so Docker Compose can mount the fixed secret contract without a secret default.
CASEWEAVER_POSTGRES_PASSWORD_FILE=
CASEWEAVER_RUNTIME_DATABASE_PASSWORD_FILE=
CASEWEAVER_MIGRATION_DATABASE_URL_FILE=
CASEWEAVER_RUNTIME_DATABASE_URL_FILE=
CASEWEAVER_OIDC_CLIENT_SECRET_FILE=
CASEWEAVER_OIDC_EPHEMERAL_ENCRYPTION_KEY_FILE=
CASEWEAVER_ADMIN_LOGIN_FILE=
CASEWEAVER_ADMIN_PASSWORD_FILE=
CASEWEAVER_OBJECT_STORAGE_KEY_DERIVATION_SECRET_FILE=
CASEWEAVER_OBJECT_STORAGE_S3_ACCESS_KEY_ID_FILE=
CASEWEAVER_OBJECT_STORAGE_S3_SECRET_ACCESS_KEY_FILE=
CASEWEAVER_TRUSTED_CA_FILE=
CASEWEAVER_TLS_CERTIFICATE_FILE=
CASEWEAVER_TLS_PRIVATE_KEY_FILE=
