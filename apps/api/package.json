    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
